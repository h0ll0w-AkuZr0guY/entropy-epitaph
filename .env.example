# OpenAI API key for AI features (epitaphs, decay content, whispers).
# Leave empty to use built-in fallback text — the app still runs offline.
OPENAI_API_KEY=

# Database URL (async SQLAlchemy). Default: local SQLite.
DATABASE_URL=sqlite+aiosqlite:///./data/entropy.db

# Local presentation mode: use the seeded showcase identity so /monuments/my
# displays all deterministic mock records. Keep false for normal per-browser sessions.
SHOWCASE_MODE=true
SHOWCASE_USER_ID=00000000-0000-4000-8000-000000000120

# Set false in API-only test processes to prevent a background scheduler.
ENABLE_SCHEDULER=true

# Optional comma-separated CORS origins for a separately hosted frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
